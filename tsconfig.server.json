{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": "src",
    "outDir": "dist/server",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/core/**/*.ts", "src/adapters/**/*.ts", "src/server/**/*.ts"]
}
